{
  "version": "2.9",
  "children": [
    {
      "type": "frame",
      "id": "aa0mc",
      "x": 0,
      "y": 0,
      "name": "Send Message Dialog",
      "clip": true,
      "width": 500,
      "fill": "$--bg",
      "cornerRadius": 8,
      "stroke": {
        "thickness": 1,
        "fill": "$--border"
      },
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "umx3L",
          "name": "Header",
          "width": "fill_container",
          "height": 44,
          "fill": "$--header-bg",
          "gap": 8,
          "padding": [
            0,
            16
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "icon_font",
              "id": "cftUu",
              "name": "hIcon",
              "width": 20,
              "height": 20,
