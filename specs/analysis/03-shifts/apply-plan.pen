                  "width": 14
                },
                {
                  "content": "Generate",
                  "fill": "$--primary-fg",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "500",
                  "id": "NyCfu",
                  "type": "text"
                }
              ],
              "cornerRadius": 8,
              "fill": "$--primary",
              "gap": 6,
              "height": 36,
              "id": "wtLBU",
              "name": "genBtn",
              "padding": [
                0,
                16
              ],
              "type": "frame"
            }
          ],
          "gap": 12,
          "height": 56,
          "id": "pgjKh",
          "justifyContent": "end",
          "name": "Footer",
          "padding": [
            0,
            24
          ],
          "stroke": {
            "align": "inside",
            "fill": "$--border",
            "thickness": {
              "top": 1
            }
          },
          "type": "frame",
          "width": "fill_container"
