Project videoclinic {
  database_type: 'MongoDB'
  Note: 'Videoclinic Database Schema'
}

Enum DayOfWeek_Enum {
  MO
  TU
  WE
  TH
  FR
  SA
  SU
}

Enum Scheduling_Enum {
  WEEKLY
  XOFMONTH
  FIRST_DAY_MONTH
  DAY_MONTH
  LAST_DAY_MONTH
}

Enum JobType_Enum {
  APPOINTMENT
  SHIFT
  TREATMENT
  TREATMENT_REPORT
}

Enum TaxType_Enum {
  SATZ_NORMAL
  SATZ_NULL
}

Enum RoundingType_Enum {
  FULL_HOUR
  HALF_HOUR
}

Enum Role_Enum {
  ADMIN
  ADMIN_INTERN
  ADMIN_KUNDE
  KUNDE
  LEITER_INTERN
  REGISTERED
  STANDARD
  GUEST
}

Enum PatientDataType_Enum {
  EXTERNAL
  EXTERNAL_BASISWEB
  INTERNAL
  INTERNAL_DAV
  INTERNAL_SECUREBOX
  INTERNAL_VCCLOUD
}

Enum LocationType_Enum {
  JVA
  MRV
  SHIP
  CLINIC
  POLICE
  OTHER
  MUKI
  INTERN
  KUR
}

Enum DefaultConsultation_Enum {
  DOCUMENT
  EXTERNAL
  INCARCERATION
  ONBOARDING
  ONBOARDING_SHORT
  STANDARD
  TREATMENT
}

Enum User_Level_Enum {
  ONBOARDING
  BEGINNER
  AMATEUR
  PROFI
}

Enum Salutation_Enum {
  MALE
  FEMALE
}

Enum Gender_Enum {
  MALE
  FEMALE
}

Enum User_Focus_Enum {
  NONE
  LOW
  MEDIUM
  HIGH
}

Enum OnboardingType_Enum {
  CHECK
}

Enum OnboardingAssignment_Enum {
  EMPLOYEE
  LOCATION
}

Enum jobId_defaultFurtherTreatment_enum {
  FOLLOW_UP
  IF_REQUIRED
  REFERRAL
  REFERRAL_OTHER
}

Enum skill_type_enum {
  ADDITIONAL
  EXTRA
  LANGUAGE
  MAIN
}

Enum patientAlerts_type_enum {
  ALLERGY
  CONSPICIOUS
  INFECTION
  OTHER
}

Enum user_employeeState_enum {
  ACTIVE
  CUSTOMER
  INACTIVE
  UNCONFIRMED
}

Enum consultationData_state_enum {
  CLOSED
  CREATED
  OPEN
  REPORTED
  TRANSMITTED
  VERIFIED
}

Enum treatment_type_enum {
  PSYCH
}

Enum treatment_state_enum {
  ACTIVE
  CANCELED
  CANCELED_CLOSED
  CLOSED
  ENDING
  PROBATORIK
  RUNNING
  STARTED
  STORNO
  STORNO_CLOSED
}

Enum notification_folder_enum {
  INBOX
  OUTBOX
  TRASH
  ARCHIVE
}

Enum notification_notificationEvent_enum {
  APPOINTMENT_ACCEPTED
  APPOINTMENT_AGREED
  APPOINTMENT_ASSIGNED
  APPOINTMENT_CANCELED
  APPOINTMENT_DISAGREED
  APPOINTMENT_DONE
  APPOINTMENT_EXPERT_AGREED
  APPOINTMENT_EXPERT_CANCELED
  APPOINTMENT_EXPERT_CANCELLED
  APPOINTMENT_EXPERT_DISAGREED
  APPOINTMENT_MULTI_AGREED
  APPOINTMENT_MULTI_DISAGREED
  APPOINTMENT_REJECTED
  APPOINTMENT_REMINDER
  APPOINTMENT_REQUEST
  APPOINTMENT_RESERVED
  APPOINTMENT_STORNO
  APPOINTMENT_UPCOMING
  ASYNC_JOB_QUEUE_ERROR
  ASYNC_JOB_QUEUE_SUCCESS
  CONSULATION_REPORTED
  CONSULATION_REPORTED_EXPERT
  CONSULATION_REPORTING
  CONSULTATION_REPORTING_PSYCHOTHERAPY
  TREATMENT_EXPERT_START
}

Enum cDRCall_type_enum {
  DIRECT
  CONFERENCE
  FORWARDED
  INVALID_MISSING_EXPERT
  INVALID_SHORT
  INVALID_UNKNOWN
}

Enum appointment_state_enum {
  ACTIVE
  CANCELED
