      ],
      "cornerRadius": 12,
      "effect": {
        "blur": 24,
        "color": "#00000020",
        "offset": {
          "x": 0,
          "y": 4
        },
        "shadowType": "outer",
        "type": "shadow"
      },
      "fill": "$--bg",
      "id": "tkEcp",
      "layout": "vertical",
      "name": "W3: Apply Plan Dialog (500px)",
      "stroke": {
        "align": "inside",
        "fill": "$--border",
        "thickness": 1
      },
      "type": "frame",
      "width": 500,
      "x": 0,
