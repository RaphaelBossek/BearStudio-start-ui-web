{"version":"2.9","variables":{"--bg":{"type":"color","value":"#FFFFFF"},"--border":{"type":"color","value":"#E5E5E5"},"--card":{"type":"color","value":"#FAFAFA"},"--danger-bg":{"type":"color","value":"#FEF2F2"},"--destructive":{"type":"color","value":"#DC2626"},"--fg":{"type":"color","value":"#0A0A0A"},"--fg-muted":{"type":"color","value":"#737373"},"--header-bg":{"type":"color","value":"#F98E33"},"--header-fg":{"type":"color","value":"#FFFFFF"},"--info-bg":{"type":"color","value":"#EFF6FF"},"--info-fg":{"type":"color","value":"#1D4ED8"},"--input-border":{"type":"color","value":"#D4D4D4"},"--primary":{"type":"color","value":"#171717"},"--primary-fg":{"type":"color","value":"#FAFAFA"},"--secondary":{"type":"color","value":"#F5F5F5"},"--secondary-fg":{"type":"color","value":"#171717"},"--success-bg":{"type":"color","value":"#F0FDF4"},"--success-fg":{"type":"color","value":"#166534"},"--warning":{"type":"color","value":"#F59E0B"},"--warning-bg":{"type":"color","value":"#FFFBEB"}},"children":[{"id":"w8Root","name":"W8 – Consultation Review","type":"frame","width":1500,"layout":"vertical","gap":0,"cornerRadius":12,"fill":"$--bg","stroke":{"thickness":1,"fill":"$--border"},"effects":[{"type":"shadow","shadowType":"outer","offset":{"x":0,"y":4},"blur":24,"color":"#00000020"}],"children":[{"id":"w8Ann0","type":"note","content":"W8 – consultation-review.pen\nReview dialog with 75%/25% split.\nLeft (75%): read-only consultation view (abbreviated)\nRight (25%): review sidebar with expert name, report end date, markdown editor (70vh, mandatory), 4 buttons.\n3-step workflow: no reporting → editing → verified."},{"id":"w8Header","name":"Dialog Header","type":"frame","width":"fill_container","height":56,"padding":[0,24],"alignItems":"center","justifyContent":"space_between","fill":"$--header-bg","cornerRadius":[12,12,0,0],"children":[{"id":"w8HdrLeft","type":"frame","gap":12,"alignItems":"center","children":[{"id":"w8HdrIco","type":"icon_font","iconFontFamily":"lucide","iconFontNa