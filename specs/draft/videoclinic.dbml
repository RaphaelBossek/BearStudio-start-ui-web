  city String [note: 'Ort']
  bank String [note: 'Bank']
  iban String [note: 'IBAN']
}

Table InvoicePosition [headercolor: #8C564B] {
  _id String [pk, note: 'Internal identifier']
  no Number [note: 'Positionsnummer']
  title String [note: 'Titel']
  description String [note: 'Beschreibung']
  amount Number [note: 'Menge']
  pricePerUnit Number [note: 'Preis pro Einheit']
  totalPrice Number [note: 'Gesamtpreis der Position']
  taxType TaxType_Enum [note: 'Steuerart:<br>• `SATZ_NORMAL` (Used)<br>• `SATZ_NULL` (Used)']
