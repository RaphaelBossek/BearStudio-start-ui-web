              "iconFontFamily": "lucide",
              "fill": "$--header-fg"
            },
            {
              "type": "text",
              "id": "jip1v",
              "name": "hText",
              "fill": "$--header-fg",
              "content": "Message",
              "fontFamily": "Inter",
              "fontSize": 17,
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "0oSSB",
          "name": "Form Body",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "padding": 20,
          "children": [
            {
              "type": "frame",
