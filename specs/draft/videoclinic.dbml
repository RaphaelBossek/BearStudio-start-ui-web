  DONE
  ERROR
  FINISHED
  RUNNING
}

Enum asyncJobQueue_type_enum {
  APPOINTMENTPLAN
  INVOICE
  SHIFTPLAN
  TREATMENT
}

Enum exportTemplate_type_enum {
  APPOINTMENT
  EXPERT
  WORKLOG
}

Enum tag_type_enum {
  COMPANY
}

Enum Address_type_enum {
  PRIVATE
  WORK
  PRAXIS
  OTHER
}

Enum ConsultationDiagnosis_localization_enum {
  LEFT
  RIGHT
  BOTH
  UNKNOWN
}

Enum ConsultationDiagnosis_level_enum {
  GENERAL
  VERIFY
  ZERO
  STATIONARY
}

Table customer [headercolor: #8C564B] {
  Note: 'Organizational entities (customers) that are assigned to locations and appointment plans.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  name String [note: 'Name des Kunden']
  code String [note: 'Kunden-Code']
  representative String [note: 'Ansprechpartner']
  email String [note: 'E-Mail-Adresse']
  uid String [note: 'Umsatzsteuer-ID']
  bank String [note: 'Kreditinstitut']
  bic String [note: 'BIC']
  iban String [note: 'IBAN']
  address String [note: 'Straße und Hausnummer']
  address2 String [note: 'Adresszusatz']
  zip String [note: 'Postleitzahl']
  city String [note: 'Ort']
  state String [note: 'Bundesland']
  country String [note: 'Land']
  webpage String [note: 'Webseite']
  phone String [note: 'Telefonnummer']
  phone2 String [note: 'Zweite Telefonnummer']
  faxnumber String [note: 'Faxnummer']
  timeframe String [note: 'Abrechnungszeitraum:<br>• `MONTHLY` (Used)']
  roundingType RoundingType_Enum [note: 'Rundungsregel']
  roundingTypeExceptions Array [note: 'Ausnahmen von der Rundungsregel']
  discounts Array [note: 'Liste von Rabatten ([CustomerDiscount](#sub-entity-customerdiscount))']
  priceLists Array [note: 'Zugeordnete Preislisten ([CustomerPriceList](#sub-entity-customerpricelist))']
  priceListsValid String [note: 'Validierungshinweis für Preislisten']
  dateCustomer timestamp [note: 'Kundendatum']
  dateCreated timestamp [note: 'Erstellungsdatum']
  createdById number [note: 'Ersteller (Reference to [user](#entity-experte-expert))']
  dateChanged timestamp [note: 'Änderungsdatum']
  changedById number [note: 'Geändert von (Reference to [user](#entity-experte-expert))']
  _class String [note: 'Java Klassenname: de.videoclinic.model.Customer']
}

Table CustomerDiscount [headercolor: #8C564B] {
  Note: 'Sub-entity for customer discounts'
  _id number [pk, note: 'Interner Bezeichner (Logical)']
  job number [note: 'Referenz ID auf jobId']
  discount number [note: 'Rabattsatz']
  comment String [note: 'Kommentar']
  dateStart timestamp [note: 'Startdatum']
  dateUntil timestamp [note: 'Enddatum']
}

Table CustomerPriceList [headercolor: #8C564B] {
  Note: 'Sub-entity for customer price lists'
  _id number [pk, note: 'Interner Bezeichner (Logical)']
  priceList Document [note: 'Snapshot der Preisliste']
  start timestamp [note: 'Startdatum']
  until timestamp [note: 'Enddatum']
  comment String [note: 'Kommentar']
}

Table appointmentPlan [headercolor: #1F77B4] {
  Note: 'Definition of a consultation schedule entry, including service, day, repetitions, times, assigned experts, locations, and customers.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  name String [note: 'Ein Name für den Plan (Freitext)']
  __ref_job_id number [note: 'Eine Dienstleistung ([PlanJob](#sub-entity-planjob))']
  day DayOfWeek_Enum [note: 'Einen Wochentag']
  startDate timestamp [note: 'Ein Startdatum']
  endDate timestamp [note: 'Einen Enddatum']
  lastDate timestamp [note: 'Ein Datum der letzten Wiederholung']
  count number [note: 'Einer Anzahl von Wiederholungen']
  scheduling Scheduling_Enum [note: 'Die Eigenschaft der Wiederholung']
  schedulingMulitplier number [note: 'Multiplikator für die Wiederholung']
  timeStart number [note: 'Einer Startuhrzeit (Format: HHmm, z.B. 930 für 09:30)']
  timeEnd number [note: 'Eine Enduhrzeit (Format: HHmm, z.B. 1200 für 12:00)']
  __ref_doctor_id Document [note: 'Einen zugewiesenen Experten ([PlanUser](#sub-entity-planuser))']
  __ref_location_id Document [note: 'Einen zugewiesenen Ort ([PlanLocation](#sub-entity-planlocation))']
  comment String [note: 'Einem Kommentar (Freitext)']
  expertOnly boolean [note: 'Gibt an, ob nur der zugewiesene Experte die Dienstleistung erbringen kann']
  dateCreated timestamp [note: 'Erstellungsdatum']
  __ref_created_by_id Document [note: 'Ersteller ([PlanUser](#sub-entity-planuser))']
  dateChanged timestamp [note: 'Änderungsdatum']
  __ref_changed_by_id Document [note: 'Ändernder ([PlanUser](#sub-entity-planuser))']
  _class String [note: 'Java Klassenname: de.videoclinic.model.AppointmentPlan']
}

Table jobId [headercolor: #8C564B] {
  Note: 'Definition of a service (Dienstleistung), including title, color, billing modality, specialty, and consultation types.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  title String [note: 'Einen Titel (intern, Experte, Rechnung)']
  code String [note: 'Eine Kurzbezeichnung']
  shortcode String [note: 'Ein Buchstabe als Kurzbezeichnung']
  expertTitle String [note: 'Titel für Experten']
  remoteCode String [note: 'Externer Code (z.B. Fachrichtung)']
  color String [note: 'Eine Farbe']
  type JobType_Enum [note: 'Die Abrechnungsmodalität:<br>• `APPOINTMENT` (Used)<br>• `SHIFT` (Used)']
  prio number [note: 'Priorität der Dienstleistung']
  skillRules Array [note: 'Regeln für benötigte Fähigkeiten ([SkillRule](#sub-entity-skillrule))']
  appointmentCondition Document [note: 'Konditionen für Termine ([AppointmentCondition](#sub-entity-appointmentcondition))']
  shiftCondition Document [note: 'Konditionen für Bereitschaften ([ShiftCondition](#sub-entity-shiftcondition))']
  consultationStandard boolean [note: 'Normale Konsultation']
  consultationOnboarding boolean [note: 'Komplette Zugangsuntersuchung']
  consultationOnboardingShort boolean [note: 'Kurze Zugangsuntersuchung']
  consultationDocument boolean [note: 'Konsiliarbericht']
  consultationIncarceration boolean [note: 'Gewahrsamstauglichkeit']
  defaultConsultation DefaultConsultation_Enum [note: 'Vorauswahl für eine Dienstleistung']
  defaultFurtherTreatment jobId_defaultFurtherTreatment_enum [note: 'Voreinstellung für die weitere Behandlung']
  onCallnumbers Array [note: 'Rufnummern für Bereitschaften']
  _class String [note: 'Java Klassenname']
}

Table skill [headercolor: #BD2882] {
  Note: 'Definition of a skill (Fähigkeit), including name, description, type, and status.'
  _id number [pk, note: 'Interner Bezeichner (MANDATORY)']
  version number [note: 'Versionsnummer']
  code String [note: 'Eine Bezeichnung der Fähigkeit']
  description String [note: 'Eine Beschreibung']
  type skill_type_enum [note: 'Art der Fähigkeit']
  active boolean [note: 'Ob die Fähigkeit aktiv oder deaktiviert ist']
  certified boolean [note: 'Ob für die Fähigkeit ein Zertifikat benötigt wird']
  _class String [note: 'Java Klassenname: de.videoclinic.model.Skill']
}

Table patientAlerts [headercolor: #2CA02C] {
  Note: 'Exclusion criteria (warnings) consisting of name, description, weight, and status.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  name String [note: 'Eine Bezeichnung des Ausschlusskriteriums (Warnhinweis)']
  type patientAlerts_type_enum [note: 'Art des Warnhinweises']
  entryRequirement boolean [note: 'Ob das Ausschlusskriterium aktiv oder deaktiviert ist']
  documentationRequirement boolean [note: 'Ob eine Dokumentationspflicht besteht']
  description String [note: 'Eine Beschreibung']
  priority number [note: 'Eine Gewichtung als Zahl']
  _class String [note: 'Java Klassenname: de.videoclinic.model.Warning']
}

Table user [headercolor: #FF7F0E] {
  Note: 'Expert profile including personal details, contact info, credentials, status, billing info, and qualifications.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  username String [note: 'Benutzername für den Login']
  email String [note: 'Primäre E-Mail-Adresse']
  password String [note: 'Persönliches Passwort']
  enabled boolean [note: 'Ob das Konto aktiv oder deaktiviert ist']
  accountLocked boolean [note: 'Ob das Konto gesperrt ist']
  accountExpired boolean [note: 'Ob das Konto abgelaufen ist']
  credentialsExpired boolean [note: 'Ob die Anmeldedaten abgelaufen sind']
  deleted boolean [note: 'Ob der Benutzer gelöscht wurde']
  external boolean [note: 'Ob es ein externer Benutzer ist']
  role Role_Enum [note: 'Rolle des Benutzers']
  employeeState user_employeeState_enum [note: 'Status des Kontos']
  userProfile Document [note: 'Persönliches Profil ([UserProfile](#sub-entity-userprofile))']
  employeeProfile Document [note: 'Berufliches Profil ([EmployeeProfile](#sub-entity-employeeprofile))']
  employerProfile Document [note: 'Arbeitgeberprofil ([EmployerProfile](#sub-entity-employerprofile))']
  nextBirthday timestamp [note: 'Nächster Geburtstag']
  totpDevice Document [note: 'TOTP-Gerät Information']
  requireTotp boolean [note: 'Ob TOTP erforderlich ist']
  totpActivity Document [note: 'Letzte TOTP-Aktivität']
  countInvalidLogin number [note: 'Anzahl ungültiger Logins']
  dateLocked timestamp [note: 'Sperrdatum des Kontos']
  lastIP String [note: 'Letzte IP-Adresse']
  countLogin number [note: 'Gesamtanzahl Logins']
  lastLogin timestamp [note: 'Letzter Login-Zeitpunkt']
  settings Document [note: 'Benutzereinstellungen']
  ip String [note: 'Aktuelle IP-Adresse']
  invalidLogins Array [note: 'Liste ungültiger Logins']
  groups Array [note: 'Liste zugeordneter Gruppen (DBRefs to group)']
  consecutiveFailedLoginAttempts number [note: 'Aufeinanderfolgende fehlgeschlagene Logins']
  successfulLogins Array [note: 'Liste erfolgreicher Logins']
  dateAcceptedLoginNotification timestamp [note: 'Akzeptanzdatum der Login-Benachrichtigung']
  resetDate timestamp [note: 'Datum des Passwort-Resets']
  resetIp String [note: 'IP des Passwort-Resets']
  resetKey String [note: 'Schlüssel für Passwort-Reset']
  dateChanged timestamp [note: 'Änderungsdatum']
  __ref_changed_by_id Document [note: 'Zuletzt geändert von']
  lastReminder timestamp [note: 'Letzte Erinnerung']
  emailVerified String [note: 'Status der E-Mail-Verifizierung']
  dateCreated timestamp [note: 'Erstellungsdatum']
  __ref_created_by_id Document [note: 'Erstellt von']
  onBoardingPercentComplete number [note: 'Onboarding Fortschritt (%)']
  stepsTotal number [note: 'Gesamtanzahl Onboarding-Schritte']
  stepsCompleted number [note: 'Abgeschlossene Onboarding-Schritte']
  customers Array [note: 'Zugeordnete Kunden (DBRefs to customer)']
  lang String [note: 'Spracheinstellung']
  verifikationKey String [note: 'Verifizierungsschlüssel']
  _class String [note: 'Java Klassenname: de.videoclinic.model.User']
}

Table product [headercolor: #8C564B] {
  Note: 'Goods or services subscribed by the expert, including quantity, price, and dates.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  name String [note: 'Name der Ware']
  description String [note: 'Beschreibung']
  konto String [note: 'Buchungskonto']
  bookingCode String [note: 'Buchungsschlüssel']
  type String [note: 'Typ der Ware']
  billType String [note: 'Abrechnungsart']
  price number [note: 'Preis']
  active boolean [note: 'Status (Aktiv/Inaktiv)']
  dateCreated timestamp [note: 'Erstellungsdatum']
  __ref_created_by_id Document [note: 'Erstellt von (Referenz auf `user`)']
  dateChanged timestamp [note: 'Änderungsdatum']
  __ref_changed_by_id Document [note: 'Geändert von (Referenz auf `user`)']
  _class String [note: 'Java Klassenname: de.videoclinic.model.Product']
}

Table consultationData [headercolor: #2CA02C] {
  Note: 'Detailed data for a consultation, including medical records, prescriptions, and results.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  date timestamp [note: 'Datum der Konsultation']
  timeStart number [note: 'Startuhrzeit (Sekunden seit Mitternacht)']
  timeEnd number [note: 'Enduhrzeit (Sekunden seit Mitternacht)']
  dateSignedOff timestamp [note: 'Datum der Abzeichnung']
  archived boolean [note: 'Archivierungsstatus']
  type consultationData_state_enum [note: 'Status']
  base Document [note: 'Basiselemente ([ConsultationBase](#sub-entity-consultationbase))']
  body Document [note: 'Körperliche Basisdaten ([ConsultationBody](#sub-entity-consultationbody))']
  warnings Array [note: 'Warnhinweise ([ConsultationWarning](#sub-entity-consultationwarning))']
  onboarding Document [note: 'Daten der Erstuntersuchung ([ConsultationOnboarding](#sub-entity-consultationonboarding))']
  standard Document [note: 'Daten einer Standard-Konsultation ([ConsultationStandard](#sub-entity-consultationstandard))']
  signedOffBy DBRef [note: 'Abgezeichnet von (Referenz auf `user`)']
  appointment DBRef [note: 'Zugehöriger Termin (Referenz auf `appointment`)']
  __ref_location_id Document [note: 'Ort der Konsultation ([ConsultationLocation](#sub-entity-consultationlocation))']
  period number [note: 'Abrechnungszeitraum']
  appointmentType JobType_Enum [note: 'Termintyp']
  __ref_customer_id Document [note: 'Zugehöriger Kunde ([ConsultationCustomer](#sub-entity-consultationcustomer))']
  __ref_job_id Document [note: 'Erbrachte Dienstleistung ([ConsultationJob](#sub-entity-consultationjob))']
  paymentType appointment_paymentType_enum [note: 'Zahlungsart']
  __ref_doctor_id Document [note: 'Durchführender Experte ([ConsultationDoctor](#sub-entity-consultationdoctor))']
  history Document [note: 'Historie ([ConsultationHistory](#sub-entity-consultationhistory))']
  booknumber String [note: 'Buchnummer (JVA)']
  jnumber String [note: 'J-Nummer (JVA)']
  basisWebDataId number [note: 'Referenz auf `basisWebData`']
  _class String [note: 'Java Klassenname: de.videoclinic.model.ConsultationData']
}

Table expertDays [headercolor: #1F77B4] {
  Note: 'Detailed availability calendar for experts, tracking shifts and appointment availability per day.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer']
  userId number [note: 'Referenz auf user']
  month number [note: 'Monat (Format: YYYYMM)']
  maxWeekDayMorning number [note: 'Maximale Vormittagsschichten (Wochentag)']
  maxWeekDayAfternoon number [note: 'Maximale Nachmittagsschichten (Wochentag)']
  maxWeekDayNight number [note: 'Maximale Nachtschichten (Wochentag)']
  maxWeekEndMorning number [note: 'Maximale Vormittagsschichten (Wochenende)']
  maxWeekEndAfternoon number [note: 'Maximale Nachmittagsschichten (Wochenende)']
  maxWeekEndNight number [note: 'Maximale Nachtschichten (Wochenende)']
  maxWeekDayAppointmentMorning number [note: 'Maximale Vormittagssprechstunden']
  maxWeekDayAppointmentAfternoon number [note: 'Maximale Nachmittagssprechstunden']
  morningNo Array [note: 'Days with explicit "No" for morning availability']
  afternoonNo Array [note: 'Tage mit explizitem "Nein" für Nachmittagsbereitschaft']
  nightNo Array [note: 'Tage mit explizitem "Nein" für Nachtbereitschaft']
  morningYes Array [note: 'Tage mit explizitem "Ja" für Vormittagsbereitschaft']
  afternoonYes Array [note: 'Tage mit explizitem "Ja" für Nachmittagsbereitschaft']
  nightYes Array [note: 'Tage mit explizitem "Ja" für Nachtbereitschaft']
  morningAppointmentNo Array [note: 'Tage mit explizitem "Nein" für Vormittagssprechstunde']
  afternoonAppointmentNo Array [note: 'Tage mit explizitem "Nein" für Nachmittagssprechstunde']
  treatmentAppointmentNo Array [note: 'Tage mit explizitem "Nein" für Therapiesprechstunde']
  morningAppointmentYes Array [note: 'Tage mit explizitem "Ja" für Vormittagssprechstunde']
  afternoonAppointmentYes Array [note: 'Tage mit explizitem "Ja" für Nachmittagssprechstunde']
  treatmentAppointmentYes Array [note: 'Days with explicit "Yes" for therapy appointment']
  __ref_changed_by_id Document [note: 'Letzte Änderung durch (Reference to user)']
  dateChanged timestamp [note: 'Zeitpunkt der letzten Änderung']
  _class String [note: 'Java class name: de.videoclinic.model.ExpertDays']
}

Table icd10 [headercolor: #9467BD] {
  Note: 'International Classification of Diseases (ICD-10) codes and descriptions.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer (Zeitstempel)']
  code String [note: 'ICD-10 Code']
  name String [note: 'Bezeichnung der Diagnose']
  text String [note: 'Detaillierter Text zur Diagnose']
  inclusion String [note: 'Einschlüsse']
  exclusion String [note: 'Ausschlusskriterien']
  ageLow number [note: 'Mindestalter']
  ageHigh number [note: 'Höchstalter']
  exotic boolean [note: 'Ob es sich um eine seltene/exotische Diagnose handelt']
  _class String [note: 'Java Klassenname: de.videoclinic.model.Icd10']
}

Table treatment [headercolor: #2CA02C] {
  Note: 'Tracking of medical treatments, including states and positions.'
  _id number [pk, note: 'Interner Bezeichner']
  version number [note: 'Versionsnummer']
  __ref_assigned_id Document [note: 'Zugewiesener Experte ([ConsultationDoctor](#sub-entity-consultationdoctor))']
  hour number [note: 'Stundenindex']
  day DayOfWeek_Enum [note: 'Wochentag:<br>• `MO` (Used)<br>• `TU` (Used)<br>• `WE` (Used)<br>• `TH` (Used)<br>• `FR` (Used)']
  booknumber String [note: 'Buchnummer (JVA)']
  jnumber String [note: 'J-Nummer (JVA)']
  type treatment_type_enum [note: 'Art der Behandlung:<br>• `PSYCH` (Used)']
  state treatment_state_enum [note: 'Status der Behandlung:<br>• `ACTIVE` (Used)<br>• `CANCELED` (Used)<br>• `CANCELED_CLOSED` (Used)<br>• `CLOSED` (Used)<br>• `ENDING` (Used)<br>• `PROBATORIK` (Used)<br>• `RUNNING` (Used)<br>• `STARTED` (Used)<br>• `STORNO` (Used)<br>• `STORNO_CLOSED` (Used)']
  dateStorno timestamp [note: 'Stornierungsdatum']
  __ref_job_id Document [note: 'Erbrachte Dienstleistung ([ConsultationJob](#sub-entity-consultationjob))']
  __ref_job_report_id Document [note: 'Dienstleistung für Berichte']
