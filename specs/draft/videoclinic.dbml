Table AsyncJobTask [headercolor: #E377C2] {
  _id String [pk, note: 'Internal identifier']
  title String [note: 'Titel des Arbeitsschritts']
  status String [note: 'Status des Arbeitsschritts (Freitext/Progress message, z.B. "25/2987/5697 OK")']
  dateStarted timestamp [note: 'Startzeitpunkt']
  dateFinished timestamp [note: 'Endzeitpunkt']
}

Table JobPriceEntry [headercolor: #8C564B] {
  _id String [pk, note: 'Internal identifier']
  jobId number [note: 'Referenz auf `jobId`']
  price number [note: 'Preiswert']
  roundingType RoundingType_Enum [note: 'Rundungsregel:<br>• `FULL_HOUR` (Used)<br>• `HALF_HOUR` (Used)']
}

Table LocationPatientDataAccess [headercolor: #E377C2] {
  _id String [pk, note: 'Internal identifier']
  user String [note: 'Benutzername']
  password String [note: 'Passwort']
  url String [note: 'Zugriff-URL']
  active boolean [note: 'Status des Zugangs']
  type String [note: 'Art des Datenzugriffs:<br>• `INTERNAL_SECUREBOX` (Used)<br>• `EXTERNAL` (Used)']
  address String [note: 'URL oder IP-Adresse der SecureBox']
  port number [note: 'Portnummer']
  secure boolean [note: 'Ob SSL verwendet wird']
  comment String [note: 'Kommentar zur Konfiguration']
}

Table UserVideoSession [headercolor: #E377C2] {
  _id String [pk, note: 'Internal identifier']
  sessionId String [note: 'Session-ID']
  date timestamp [note: 'Zeitpunkt']
  timeWatched number [note: 'Zuschauerzeit in dieser Sitzung']
}

Table StornoRule [headercolor: #8C564B] {
  _id String [pk, note: 'Internal identifier']
  name String [note: 'Bezeichnung der Regel']
  stornoTime number [note: 'Zeitpunkt (in Sekunden/Millisekunden vor Termin)']
  percentage number [note: 'Prozentsatz der Kosten']
  comment String [note: 'Kommentar']
}

Table TaxValue [headercolor: #8C564B] {
  _id String [pk, note: 'Internal identifier']
  name String [note: 'Bezeichnung']
  value number [note: 'Prozentsatz']
  enabled boolean [note: 'Status']
}

