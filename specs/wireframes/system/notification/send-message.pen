                  "children": [
                    {
                      "type": "text",
                      "id": "G1Yeo",
                      "name": "recipLbl",
                      "fill": "$--fg",
                      "content": "Recipient",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "600"
                    },
                    {
                      "type": "frame",
                      "id": "Pfx1h",
                      "name": "recipInp",
                      "width": "fill_container",
                      "height": 36,
                      "cornerRadius": 4,
