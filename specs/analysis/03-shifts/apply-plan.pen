      "type": "color",
      "value": "#166534"
    },
    "--warning": {
      "type": "color",
      "value": "#F59E0B"
    },
    "--warning-bg": {
      "type": "color",
      "value": "#FFFBEB"
    }
  },
  "children": [
    {
      "children": [
        {
          "alignItems": "center",
          "children": [
            {
              "fill": "$--header-fg",
              "height": 20,
              "iconFontFamily": "lucide",
              "iconFontName": "play",
              "id": "ULGEr",
              "type": "icon_font",
              "width": 20
            },
            {
              "content": "Apply Shift Plan",
              "fill": "$--header-fg",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "600",
              "id": "t2Uuc",
              "type": "text"
            }
          ],
          "cornerRadius": [
            12,
            12,
            0,
            0
          ],
          "fill": "$--header-bg",
          "gap": 10,
          "height": 48,
          "id": "LpVTq",
          "name": "Header",
          "padding": [
            0,
            16
          ],
          "type": "frame",
          "width": "fill_container"
        },
        {
          "children": [
            {
              "content": "Generate shift appointments from plan templates until the selected date.",
              "fill": "$--fg",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal",
              "id": "afRaW",
              "textGrowth": "fixed-width",
              "type": "text",
              "width": "fill_container"
            },
            {
              "children": [
                {
                  "content": "Generate Until *",
                  "fill": "$--fg",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "500",
                  "id": "HstAx",
                  "type": "text"
                },
                {
                  "alignItems": "center",
                  "children": [
                    {
                      "content": "2026-06-30",
                      "fill": "$--fg",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal",
                      "id": "4VaWm",
                      "type": "text"
                    },
                    {
                      "fill": "$--fg-muted",
                      "height": 16,
                      "iconFontFamily": "lucide",
                      "iconFontName": "calendar",
                      "id": "mQpoQ",
                      "type": "icon_font",
                      "width": 16
                    }
                  ],
                  "cornerRadius": 8,
                  "height": 36,
                  "id": "GjqdC",
                  "justifyContent": "space_between",
                  "name": "dateInp",
                  "padding": [
                    8,
                    12
                  ],
                  "stroke": {
                    "align": "inside",
                    "fill": "$--input-border",
                    "thickness": 1
                  },
                  "type": "frame",
                  "width": "fill_container"
                }
              ],
              "gap": 4,
              "id": "UNVFs",
              "layout": "vertical",
              "name": "fieldWrap",
              "type": "frame",
              "width": "fill_container"
            },
            {
              "children": [
                {
                  "fill": "$--info-fg",
                  "height": 16,
                  "iconFontFamily": "lucide",
                  "iconFontName": "info",
                  "id": "Tiar3",
                  "type": "icon_font",
                  "width": 16
                },
                {
                  "content": "Appointments will be created for all active shift plans. Existing appointments in the date range will not be duplicated.",
                  "fill": "$--info-fg",
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal",
                  "id": "w8uMV",
                  "textGrowth": "fixed-width",
                  "type": "text",
                  "width": "fill_container"
                }
              ],
              "cornerRadius": 8,
              "fill": "$--info-bg",
              "gap": 10,
              "id": "zpaeu",
              "name": "infoBox",
              "padding": 16,
              "type": "frame",
              "width": "fill_container"
            }
          ],
          "gap": 16,
          "id": "gaUEO",
          "layout": "vertical",
          "name": "Body",
          "padding": 24,
          "type": "frame",
          "width": "fill_container"
        },
        {
          "alignItems": "center",
          "children": [
            {
              "alignItems": "center",
              "children": [
                {
                  "content": "Cancel",
                  "fill": "$--fg",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "500",
                  "id": "N0Yx2",
                  "type": "text"
                }
              ],
              "cornerRadius": 8,
              "height": 36,
              "id": "pHlkZ",
              "name": "cancelBtn",
              "padding": [
                0,
                16
              ],
              "stroke": {
                "align": "inside",
                "fill": "$--input-border",
                "thickness": 1
              },
              "type": "frame"
            },
            {
              "alignItems": "center",
              "children": [
                {
                  "fill": "$--primary-fg",
                  "height": 14,
                  "iconFontFamily": "lucide",
                  "iconFontName": "play",
                  "id": "D6qcg",
