    {
      "type": "note",
      "id": "8melY",
      "x": 520,
      "y": 50,
      "name": "annotation",
      "width": 260,
      "height": 100,
      "content": "Dashboard-included quick compose. Can be pre-filled from context (e.g., birthday card: subject='Happy Birthday', message=greeting template). Focus goes to textarea if recipient pre-filled, otherwise to recipient input."
    }
  ],
