{"version": "2.9", "variables": {"--admin-bg": {"type": "color", "value": "#FFF7ED"}, "--admin-border": {"type": "color", "value": "#FB923C"}, "--bg": {"type": "color", "value": "#FFFFFF"}, "--border": {"type": "color", "value": "#E5E5E5"}, "--card": {"type": "color", "value": "#FAFAFA"}, "--danger-bg": {"type": "color", "value": "#FEF2F2"}, "--destructive": {"type": "color", "value": "#DC2626"}, "--fg": {"type": "color", "value": "#0A0A0A"}, "--fg-muted": {"type": "color", "value": "#737373"}, "--header-bg": {"type": "color", "value": "#F98E33"}, "--header-fg": {"type": "color", "value": "#FFFFFF"}, "--info-bg": {"type": "color", "value": "#EFF6FF"}, "--info-fg": {"type": "color", "value": "#1D4ED8"}, "--input-border": {"type": "color", "value": "#D4D4D4"}, "--primary": {"type": "color", "value": "#171717"}, "--primary-fg": {"type": "color", "value": "#FAFAFA"}, "--secondary": {"type": "color", "value": "#F5F5F5"}, "--secondary-fg": {"type": "color", "value": "#171717"}, "--success-bg": {"type": "color", "value": "#F0FDF4"}, "--success-fg": {"type": "color", "value": "#166534"}, "--warning": {"type": "color", "value": "#F59E0B"}, "--warning-bg": {"type": "color", "value": "#FFFBEB"}}, "children": [{"type": "frame", "id": "GLnd8", "x": 0, "y": 0, "name": "W6: Signature Pad", "width": 500, "fill": "$--bg", "cornerRadius": 12, "stroke": {"align": "inside", "thickness": 1, "fill": "$--border"}, "layout": "vertical", "children": [{"type": "frame", "id": "UGU8g", "name": "Header", "width": "fill_container", "stroke": {"align": "inside", "thickness": {"bottom": 1}, "fill": "$--border"}, "gap": 8, "padding": [16, 20], "alignItems": "center", "children": [{"type": "icon_font", "id": "VPqUk", "name": "si", "width": 18, "height": 18, "iconFontName": "pen-tool", "iconFontFamily": "lucide", "fill": "$--fg"}, {"type": "text", "id": "irmaq", "name": "st", "fill": "$--fg", "content": "Signature", "fontFamily": "Inter", "fontSize": 18, "fontWeight": "700"}]}, {"type": "frame", "id": "pLOsx", "name": "Body", "width": "fill_container", "layout": "vertical", "gap": 16, "padding": 20, "alignItems": "center", "children": [{"type": "frame", "id": "8zClu", "name": "Canvas Area", "width": "fill_container", "height": 200, "fill": "$--bg", "cornerRadius": 8, "stroke": {"align": "inside", "thickness": 2, "fill": "$--border"}, "layout": "none", "children": [{"type": "frame", "id": "xiCA6", "layoutPosition": "absolute", "x": 25, "y": 160, "name": "sline", "width": 400, "height": 1, "fill": "$--fg-muted"}, {"type": "text", "id": "iKEGk", "layoutPosition": "absolute", "x": 180, "y": 170, "name": "slabel", "fill": "$--fg-muted", "content": "Sign above [HARDCODED]", "fontFamily": "Inter", "fontSize": 11, "fontWeight": "normal"}]}, {"type": "text", "id": "DAGXf", "name": "shint", "fill": "$--fg-muted", "content": "PNG/JPG Maximum 800x300px (recommended: 400x150px) [HARDCODED]", "fontFamily": "Inter", "fontSize": 11, "fontWeight": "normal"}]}, {"type": "frame", "id": "svsEe", "name": "Footer", "width": "fill_container", "stroke": {"align": "inside", "thickness": {"top": 1}, "fill": "$--border"}, "gap": 12, "padding": [12, 20], "justifyContent": "end", "children": [{"type": "frame", "id": "6BsyZ", "name": "ssign", "fill": "$--primary", "cornerRadius": 8, "padding": [8, 16], "alignItems": "center", "children": [{"type": "text", "id": "ekLI9", "name": "ssignt", "fill": "$--primary-fg", "content": "Sign", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "500"}]}, {"type": "frame", "id": "LD7Ax", "name": "sclear", "cornerRadius": 8, "stroke": {"align": "inside", "thickness": 1, "fill": "$--border"}, "padding": [8, 16], "alignItems": "center", "children": [{"type": "text", "id": "JrFbn", "name": "sclt", "fill": "$--fg", "content": "Clear", "fontFamily": "Inter", "fontSize": 13, "fontWeight": "500"}]}]}, {"type": "note", "id": "cfzdt", "name": "snote", "width": 460, "height": 70, "content": "Signature Pad:\n- Uses SignaturePad library (signature_pad.umd.min.js)\n- High-DPI canvas: devicePixelRatio scaling\n- Config: transparent bg, max stroke 1.5\n- Sign: toDataURL() -> UserService.updateSignature(userId, base64)\n- Clear: signaturePad.clear() + resizeCanvas()\n- Included by personal.htmlm AND staff.htmlm\n@shadcn/dialog + react-signature-canvas"}]}]}