  type ConsultationPatientReport_type_enum [note: 'Art des Berichts:<br>• `FINDINGS` (Used)<br>• `MEASUREMENT` (Used)']
  documentation String [note: 'Dokumentationstext']
}

Table ConsultationWorkIncapacity [headercolor: #2CA02C] {
  _id String [pk, note: 'Internal identifier']
  dateStart Date [note: 'Startdatum']
  dateEnd Date [note: 'Enddatum']
  comment String [note: 'Kommentar']
}

Table ConsultationDoctor [headercolor: #2CA02C] {
  _id number [pk, note: 'Referenz ID auf `user`']
  name String [note: 'Name des Experten']
  email String [note: 'E-Mail-Adresse']
  formalDisplayName String [note: 'Vollständiger Name mit Titel']
}

Table ConsultationJob [headercolor: #2CA02C] {
  _id number [pk, note: 'Referenz ID auf `jobId`']
  code String [note: 'Dienstleistungscode']
  color String [note: 'Farbe']
  expertTitle String [note: 'Titel für Experten']
  remoteCode String [note: 'Externer Code']
  title String [note: 'Titel']
  type JobType_Enum [note: 'Abrechnungsart (z.B. `APPOINTMENT`):<br>• `APPOINTMENT` (Used)<br>• `SHIFT` (Used)']
}

Table ConsultationLocation [headercolor: #2CA02C] {
  _id number [pk, note: 'Referenz ID auf `location`']
  name String [note: 'Name des Ortes']
  booknumberMask String [note: 'Maske für Buchnummern']
  patientDataType PatientDataType_Enum [note: 'Datentyp der Patienten:<br>• `EXTERNAL` (Used)<br>• `INTERNAL_SECUREBOX` (Used)']
  customer Document [note: 'Zugehöriger Kunde ([ConsultationCustomer](#sub-entity-consultationcustomer))']
}

Table ConsultationCustomer [headercolor: #2CA02C] {
  _id number [pk, note: 'Referenz ID auf `customer`']
  name String [note: 'Name des Kunden']
}

Table TreatmentPosition [headercolor: #2CA02C] {
  _id String [pk, note: 'Internal identifier']
  appointmentId number [note: 'Referenz auf `appointment`']
  start Date [note: 'Startzeitpunkt']
  until Date [note: 'Endzeitpunkt']
  state TreatmentPosition_state_enum [note: 'Status des Termins:<br>• `CANCELED` (Used)<br>• `CLOSED` (Used)<br>• `DONE` (Used)<br>• `LOCKEDIN` (Used)<br>• `READY` (Used)<br>• `RESCHEDULED` (Used)<br>• `STORNO` (Used)']
  requireReport Boolean [note: 'Bericht erforderlich']
  report Document [note: 'Referenz auf den Bericht ([TreatmentReport](#sub-entity-treatmentreport))']
}

Table TreatmentReport [headercolor: #2CA02C] {
  _id String [pk, note: 'Internal identifier']
  type TreatmentReport_type_enum [note: 'Art des Berichts:<br>• `STANDARD` (Used)']
  consultationId number [note: 'Referenz auf `consultationData`']
  date Date [note: 'Datum des Berichts']
}

Table BasisWebMedication [headercolor: #D62728] {
  _id number [pk, note: 'Interner Bezeichner']
  date String [note: 'Datum']
  type String [note: 'Art des Medikaments (Encrypted/Hashed)']
  content String [note: 'Inhalt/Wirkstoff']
  entry String [note: 'Eintragstext']
  note String [note: 'Notiz']
  until String [note: 'Gültig bis']
}

Table BasisWebWarning [headercolor: #D62728] {
  _id String [pk, note: 'Internal identifier']
  date String [note: 'Datum']
  active String [note: 'Status (Encrypted/Hashed)']
  type String [note: 'Art der Warnung (Encrypted/Hashed)']
  content String [note: 'Inhaltstext']
}

Table BasisWebEntry [headercolor: #D62728] {
  _id String [pk, note: 'Internal identifier']
  date String [note: 'Datum']
  active String [note: 'Status (Encrypted/Hashed)']
  type String [note: 'Art des Eintrags (Encrypted/Hashed)']
  content String [note: 'Inhaltstext']
}

Table InvoiceComponentStorno [headercolor: #8C564B] {
