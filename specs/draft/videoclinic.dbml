}

Table MedicationProduct [headercolor: #9467BD] {
  _id String [pk, note: 'Internal identifier']
  name String [note: 'Name der Packung']
  packaging String [note: 'Packungsgröße (z.B. "50 g (N2)")']
  packageName String [note: 'Ausgeschriebener Packungsname']
