{
  "version": "2.9",
  "children": [
    {
      "type": "frame",
      "id": "h2WsT",
      "x": 0,
      "y": 0,
      "name": "W13a: End Shift Dialog",
      "width": 600,
      "fill": "$--bg",
      "cornerRadius": 8,
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$--border"
      },
      "effect": {
        "type": "shadow",
        "shadowType": "outer",
        "color": "#0000001a",
        "offset": {
          "x": 0,
          "y": 2
        },
        "blur": 4
      },
      "layout": "vertical",
      "children": [
        {
          "type": "frame",
          "id": "kQjFh",
          "name": "Dialog Header",
          "width": "fill_container",
          "fill": "$--header-bg",
          "cornerRadius": [
            8,
            8,
            0,
            0
          ],
          "gap": 12,
          "padding": [
            12,
            24
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "icon_font",
              "id": "VEW0u",
              "name": "hdrIcon",
              "width": 20,
              "height": 20,
              "iconFontName": "clock",
              "iconFontFamily": "lucide",
              "fill": "$--header-fg"
            },
            {
              "type": "text",
              "id": "KioBt",
              "name": "hdrTitle",
              "fill": "$--header-fg",
              "content": "Shift",
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "UVcjH",
              "name": "hdrAnnot",
              "fill": "#FFFFFFAA",
              "content": "@shadcn/alert-dialog — endShiftDlg",
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "XUTJF",
          "name": "Dialog Body",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "padding": 24,
          "children": [
            {
              "type": "text",
              "id": "zTiZU",
              "name": "confirmTxt",
              "fill": "$--fg",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Should the operation really be ended?",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "m2m10",
              "name": "instructTxt",
              "fill": "$--fg-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Please correct the times if necessary.",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "WzQsT",
              "name": "Time Inputs Row",
              "width": "fill_container",
              "gap": 16,
              "children": [
                {
                  "type": "frame",
                  "id": "mxS3w",
                  "name": "Start Time *",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "frame",
                      "id": "x7wOT",
                      "name": "startLbl",
                      "gap": 6,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon_font",
                          "id": "smMeL",
                          "name": "startIcon",
                          "width": 14,
                          "height": 14,
                          "iconFontName": "play",
                          "iconFontFamily": "lucide",
                          "fill": "$--fg-muted"
                        },
                        {
                          "type": "text",
                          "id": "NJloc",
                          "name": "startLblTxt",
                          "fill": "$--fg",
                          "content": "Start Time *",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "500"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "eeX2m",
                      "name": "startInput",
                      "width": "fill_container",
                      "fill": "$--bg",
                      "cornerRadius": 6,
                      "stroke": {
                        "align": "inside",
                        "thickness": 1,
                        "fill": "$--input-border"
                      },
                      "padding": [
                        8,
                        12
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "jfH8A",
                          "name": "startTxt",
                          "fill": "$--fg",
                          "content": "08:00",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "BBJU2",
                  "name": "End Time *",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "frame",
                      "id": "UrPLA",
                      "name": "endLbl",
                      "gap": 6,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon_font",
                          "id": "3zzp2",
                          "name": "endIcon",
                          "width": 14,
                          "height": 14,
                          "iconFontName": "square",
                          "iconFontFamily": "lucide",
                          "fill": "$--fg-muted"
                        },
                        {
                          "type": "text",
                          "id": "CFPmj",
                          "name": "endLblTxt",
                          "fill": "$--fg",
                          "content": "End Time *",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "500"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "X92K5",
                      "name": "endInput",
                      "width": "fill_container",
                      "fill": "$--bg",
                      "cornerRadius": 6,
                      "stroke": {
                        "align": "inside",
                        "thickness": 1,
                        "fill": "$--input-border"
                      },
                      "padding": [
                        8,
                        12
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "YdL9U",
                          "name": "endTxt",
                          "fill": "$--fg",
                          "content": "16:00",
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "U60M9",
          "name": "Dialog Footer",
          "width": "fill_container",
          "stroke": {
            "align": "inside",
            "thickness": {
              "top": 1
            },
            "fill": "$--border"
          },
          "gap": 12,
          "padding": [
            16,
            24
          ],
          "justifyContent": "end",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "GDPNy",
              "name": "cancelBtn",
              "fill": "$--secondary",
              "cornerRadius": 6,
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$--border"
              },
              "padding": [
                8,
                16
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "TmBoY",
                  "name": "cancelTxt",
                  "fill": "$--secondary-fg",
                  "content": "Cancel",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "500"
                }
              ]
            },
            {
              "type": "frame",
              "id": "iIrit",
              "name": "confirmBtn",
              "fill": "$--primary",
              "cornerRadius": 6,
              "padding": [
                8,
                16
              ],
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "ixrk9",
                  "name": "confirmBtnTxt",
                  "fill": "$--primary-fg",
                  "content": "End Shift",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "500"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "Ee2qG",
          "name": "n1",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "padding": [
            12,
            24
          ],
          "children": [
            {
              "type": "note",
              "id": "7D4RV",
              "name": "Behavior Note",
              "width": 550,
              "height": 40,
              "content": "Save callback: AppointmentService.done(id, timeStart, timeEnd, qm). On error → dialog re-opens for correction. On success → page reloads. Triggered when .endAppointment clicked and ap.shift is truthy."
            }
          ]
        }
      ]
    }
  ],
  "variables": {
    "--bg": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "--border": {
      "type": "color",
      "value": "#E5E5E5"
    },
    "--fg": {
      "type": "color",
      "value": "#0A0A0A"
    },
    "--fg-muted": {
      "type": "color",
      "value": "#737373"
    },
    "--header-bg": {
      "type": "color",
      "value": "#3B82F6"
    },
    "--header-fg": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "--info-bg": {
      "type": "color",
      "value": "#EFF6FF"
    },
    "--info-fg": {
      "type": "color",
      "value": "#1D4ED8"
    },
    "--input-border": {
      "type": "color",
      "value": "#D4D4D4"
    },
    "--primary": {
      "type": "color",
      "value": "#171717"
    },
    "--primary-fg": {
      "type": "color",
      "value": "#FAFAFA"
    },
    "--secondary": {
      "type": "color",
      "value": "#F5F5F5"
    },
    "--secondary-fg": {
      "type": "color",
      "value": "#171717"
    }
  }
}