epD","name":"Accept (disabled)","opacity":0.4,"padding":[3,6],"type":"frame"},{"children":[{"content":"Reserve","fill":"$--fg-muted","fontFamily":"Inter","fontSize":9,"fontWeight":"500","id":"Oe474","name":"ab3t","type":"text"}],"cornerRadius":4,"fill":"$--secondary","id":"Iz0b6","name":"Reserve (disabled)","opacity":0.4,"padding":[3,6],"type":"frame"}],"gap":4,"id":"337JU","name":"Action buttons","type":"frame"}],"gap":4,"id":"Wjuzj","layout":"vertical","name":"State + Actions","type":"frame","width":200}],"gap":8,"id":"e9Zzb","name":"Row 2 \u2014 data.assigned (AGREED)","padding":[10,24],"stroke":{"align":"inside","fill":"$--border","thickness":{"bottom":1}},"type":"frame","width":"fill_container"}],"id":"fH5Ty","layout":"vertical","name":"Table: data.assigned \u2014 @shadcn/table","type":"frame","width":"fill_container"}],"cornerRadius":8,"effect":{"blur":4,"color":"#0000001a","offset":{"x":0,"y":2},"shadowType":"outer","type":"shadow"},"fill":"$--bg","id":"fFK24","layout":"vertical","name":"W2c: Tab 4 \u2014 Assigned (Expert Confirm)","stroke":{"align":"inside","fill":"$--border","thickness":1},"type":"frame","width":600,"x":20,"y":20},{"content":"Assignment State Machine \u2014 Button Disable Rules:\n\nACCEPTED \u2192 disable: accept\nREJECTED \u2192 disable: reject, abort\nRESERVED \u2192 disable: reserve\nABORTED \u2192 disable: accept, reserve\nCANCELED \u2192 disable: abort, accept, reserve\nAGREED \u2192 disable: override, accept, reserve\nDOUBLE_BOOKED \u2192 disable: reserve\nDISAGREED \u2192 disable: accept, reject, abort, reserve\n\nRole Icon Logic:\nsupport=true \u2192 blue shield (Support)\nsupport=false \u2192 green shield (Main)\nsupport=null \u2192 stethoscope (Doctor)","height":0,"id":"KPEFM","name":"note1","type":"note","width":400,"x":640,"y":20},{"content":"Collision Handling (addUser):\n\nOn doctor autocomplete insert \u2192 AppointmentService.addUser(appointmentId, userId, false)\n\nError codes:\n\u2022 double.booking \u2192 confirm(longMessage + proceed anyway?)\n\u2022 expert.not.available \u2192 confirm(longMessage + proceed anyway?)\n\u2022 expert.unavailable \u2192 confirm(longMessage + inactiveReason + proceed anyway?)\n\nIf user confirms \u2192 re-call with force=true.\nIf duplicates > 1 \u2192 opens W3 collision dialog.\n\nToolbar only visible in states: READY, STARTED, REOPENED, REQUESTED, LOCKEDIN.","height":0,"id":"JsF7O","name":"note2","type":"note","width":400,"x":640,"y":160}]}