s":1},"type":"frame","width":18},{"content":"Dangerous","fill":"$--fg","fontFamily":"Inter","fontSize":13,"fontWeight":"normal","id":"w4EvDT","type":"text"}],"gap":8,"id":"w4EvDangerous","name":"dangerous","type":"frame"}],"gap":16,"id":"w4EvR3","type":"frame","width":"fill_container"}],"gap":12,"id":"w4EvGrid","layout":"vertical","type":"frame","width":"fill_container"},{"children":[{"content":"Suitability Information","fill":"$--fg","fontFamily":"Inter","fontSize":12,"fontWeight":"500","id":"w4EvILbl","type":"text"},{"children":[{"content":"Additional suitability information...","fill":"$--fg-muted","fontFamily":"Inter","fontSize":13,"fontWeight":"normal","id":"w4EvIPH","type":"text"}],"cornerRadius":8,"height":80,"id":"w4EvITA","padding":[8,12],"stroke":{"fill":"$--input-border","thickness":1},"type":"frame","width":"fill_container"}],"gap":4,"id":"w4EvInfo","layout":"vertical","name":"suitability info textarea","type":"frame","width":"fill_container"}],"cornerRadius":[0,0,8,8],"gap":12,"id":"w4R2Body","layout":"vertical","padding":16,"stroke":{"fill":"$--border","thickness":1},"type":"frame","width":"fill_container"}],"gap":16,"id":"w4Row2","layout":"vertical","name":"Row 2 \u2013 Evaluation","type":"frame","width":"fill_container"}],"fill":"$--bg","gap":24,"id":"w4Root","layout":"vertical","name":"W4 \u2013 Onboarding Consultation Details","padding":24,"type":"frame","width":1440,"x":20,"y":20},{"content":"W4 \u2013 consultation-details-onboarding.pen\nFull onboarding form with ~50 fields split into 2 major rows.\nRow 1: Medical History & Examination\nRow 2: Evaluation\nNote: ONBOARDING_SHORT is a strict subset \u2014 only generalState, weightState + evaluation section.","height":0,"id":"87wt7","name":"note1","type":"note","width":0,"x":1480,"y":20},{"content":"[conditionize2: OTHER shows textarea]\nWhen 'OTHER' is selected, show additional textarea below.","height":0,"id":"oke1Y","name":"note2","type":"note","width":0,"x":1480,"y":120},{"content":"Each infectious disease: UNKNOWN / SURE / EXCLUDED","height":0,"id":"PTOhE","name":"note3","type":"note","width":0,"x":1480,"y":220},{"content":"ONBOARDING_SHORT note:\nONBOARDING_SHORT is a strict subset of this form.\nIt only includes:\n- generalState (from Row 1 States section)\n- weightState (from Row 1 States section)\n- Entire Evaluation section (Row 2)\nAll other fields in Row 1 (family history, physical findings, organ systems, etc.) are hidden for ONBOARDING_SHORT.","height":0,"id":"TLeje","name":"note4","type":"note","width":0,"x":1480,"y":320}]}