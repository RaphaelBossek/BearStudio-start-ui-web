// This is the Prisma schema file for the secondary MongoDB connection

generator client {
  provider     = "prisma-client"
  output       = "../src/server/db/generated-mongodb"
  moduleFormat = "esm"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model ExpertWeek {
  id          BigInt    @id @map("_id")
  version     BigInt?
  userId      BigInt?
  type        String?
  slotsMo     Float[]
  slotsTu     Float[]
  slotsWe     Float[]
  slotsTh     Float[]
  slotsFr     Float[]
  slotsSa     Float[]
  slotsSu     Float[]
  dateChanged DateTime?
  dateCreated DateTime?
  class       String?   @map("_class")

  @@map("expertWeek")
}

model UserMongo {
  id                             BigInt           @id @map("_id")
  version                        BigInt?
  username                       String?
  email                          String?
  password                       String?
  enabled                        Boolean?
  accountLocked                  Boolean?
  accountExpired                 Boolean?
  credentialsExpired             Boolean?
  deleted                        Boolean?
  external                       Boolean?
  role                           String?
  employeeState                  String?
  userProfile                    UserProfile?
  employeeProfile                EmployeeProfile?
  employerProfile                EmployerProfile?
  nextBirthday                   DateTime?
  totpDevice                     TotpDevice?
  requireTotp                    Boolean?
  totpActivity                   TotpActivity?
  countInvalidLogin              Int?
  dateLocked                     DateTime?
  lastIP                         String?
  countLogin                     Int?
  lastLogin                      DateTime?
  settings                       Json?
  ip                             String?
  invalidLogins                  LoginEvent[]
  // groups                        Json[]           // DBRefs
  consecutiveFailedLoginAttempts Int?
  successfulLogins               LoginEvent[]
  dateAcceptedLoginNotification  DateTime?
  resetDate                      DateTime?
  resetIp                        String?
  resetKey                       String?
  dateChanged                    DateTime?
  changedBy                      UserPlanUser?
  lastReminder                   DateTime?
  emailVerified                  String?
  dateCreated                    DateTime?
  createdBy                      UserPlanUser?
  onBoardingPercentComplete      Float?
  stepsTotal                     Int?
  stepsCompleted                 Int?
  // customers                     Json[]           // DBRefs
  lang                           String?
  verifikationKey                String?
  class                          String?          @map("_class")

  @@map("user")
}

type UserProfile {
  id                   String?
  firstName            String?
  lastName             String?
  displayName          String?
  title                String?
  salutation           String?
  gender               String?
  birthday             DateTime?
  mainAddress          UserAddress?
  cellularNumber       String?
  shiftPhoneNumber     String?
  notificationPerMail  Boolean?
  exludedNotifications String[]
  photo                FileMetadata?
  homePhone            String?
  faxNumber            String?
  workPhone            String?
  userId               BigInt?
}

type EmployeeProfile {
  id                String?
  email2            String?
  activeSince       DateTime?
  bank              String?
  iban              String?
  bic               String?
  taxid             String?
  uid               String?
  mailInvoice       Boolean?
  postInvoice       Boolean?
  shift             String?
  appointment       String?
  therapy           String?
  skills            EmployeeSkillAssignment[]
  exclusionCriteria String[]
  imageSignature    FileMetadata?
  bayernBoxAccess   BayernBoxAccess?
  categoriesWatched WatchedCategory[]
}

type EmployeeSkillAssignment {
  id                String?
  // skill          Json?             // DBRef
  active            Boolean?
  dateCertification DateTime?
  certification     FileMetadata?
}

type EmployerProfile {
  id                          String?
  konto                       String?
  gkto                        String?
  efn                         String?
  level                       String?
  activeSince                 DateTime?
  activeUntil                 DateTime?
  activeSinceVC               DateTime?
  activeUntilVC               DateTime?
  // products                 Json[]            // DBRefs
  // sipAccounts              Json[]
  // employeeType             Json[]
  currentIncome               Float?
  inctiveReason               String?
  experienceAddictionMedicine String?
}

type UserAddress {
  id       BigInt?
  name     String?
  address  String?
  address2 String?
  zip      String?
  city     String?
  state    String?
  country  String?
  type     String?
}

type FileMetadata {
  id          String?   @map("_id")
  name        String?
  mime        String?
  size        BigInt?
  checksum    String?
  type        String?
  dateCreated DateTime?
}

type TotpDevice {
  ip             String?
  dateRegistered DateTime?
  secret         String?
  activated      DateTime?
}

type TotpActivity {
  dateAccess DateTime?
  ip         String?
  ua         String?
  action     String?
}

type LoginEvent {
  ip    String?
  date  DateTime?
  first DateTime?
  ua    String?
  count Int?
}

type UserPlanUser {
  id                BigInt? @map("_id")
  name              String?
  email             String?
  formalDisplayName String?
}

type BayernBoxAccess {
  username String?
  password String?
}

type WatchedCategory {
  categoryId BigInt?
  date       DateTime?
}

model Appointment {
  id                          BigInt                @id @map("_id")
  version                     BigInt?
  start                       DateTime?
  until                       DateTime?
  adjustedStart               DateTime?
  adjustedUntil               DateTime?
  actualStart                 DateTime?
  actualUntil                 DateTime?
  loggedStart                 DateTime?
  loggedUntil                 DateTime?
  verifiedStart               DateTime?
  verifiedUntil               DateTime?
  billStart                   DateTime?
  billUntil                   DateTime?
  dateStarted                 DateTime?
  dateDone                    DateTime?
  dateStorno                  DateTime?
  firstContact                DateTime?
  dateCreated                 DateTime?
  dateChanged                 DateTime?
  title                       String?
  comment                     String?
  state                       String?
  type                        String?
  job                         ConsultationJob?
  billingType                 String?
  paymentType                 String?
  priceType                   String?
  customer                    ConsultationCustomer?
  location                    ConsultationLocation?
  treatmentId                 BigInt?
  minPatients                 Int?
  actualPatients              Int?
  billablePatients            Int?
  payablePatients             Int?
  billableBaseTime            BigInt?
  workTimePlanned             BigInt?
  workTimeActual              BigInt?
  workTimeIs                  BigInt?
  requiredStaffCount          Int?
  addedStaffCount             Int?
  backlogCount                Int?
  adjustedStaffCount          Int?
  assignedStaffCount          Int?
  reservedStaffCount          Int?
  missing                     BigInt?
  finished                    Boolean?
  countFurtherFollowUp        Int?
  countFurtherIfRequired      Int?
  countFurtherReferral        Int?
  countFurtherReferralOther   Int?
  period                      Int?
  changedById                 BigInt?
  createdById                 BigInt?
  stornoById                  BigInt?
  planId                      BigInt?
  shiftPlanId                 BigInt?
  expertOnly                  Boolean?
  jobSupport                  Boolean?
  treatmentRequireReport      Boolean?
  assignedDisplayName         String?
  // expertAppointment        Json?
  unmatchedShiftCalls         Int?
  unmatchedConsultationsCalls Int?
  class                       String?               @map("_class")

  @@map("appointment")
}

type ConsultationJob {
  id          BigInt? @map("_id")
  title       String?
  code        String?
  shortcode   String?
  expertTitle String?
  color       String?
  type        String?
}

type ConsultationCustomer {
  id          BigInt? @map("_id")
  name        String?
  displayName String?
}

type ConsultationLocation {
  id      BigInt? @map("_id")
  name    String?
  address String?
}

type ConsultationDoctor {
  id          BigInt? @map("_id")
  name        String?
  displayName String?
  email       String?
}

model ShiftPlan {
  id                   BigInt               @id @map("_id")
  version              BigInt?
  name                 String?
  day                  String?
  scheduling           String?
  schedulingMulitplier Int?
  timeStart            Int?
  timeEnd              Int?
  job                  ConsultationJob?
  minPatients          Int?
  count                Int?
  lastDate             DateTime?
  priceType            String?
  dateChanged          DateTime?
  changedBy            ConsultationDoctor?
  dateCreated          DateTime?
  createdBy            ConsultationDoctor?
  comment              String?
  // prefered          Json[]               // DBRefs to preferred doctors
  class                String?              @map("_class")

  @@map("shiftPlan")
}
