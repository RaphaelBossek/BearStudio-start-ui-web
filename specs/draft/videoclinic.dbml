  READY
  REQUESTED
  RESCHEDULED
  STARTED
  STORNO
}

Enum appointment_paymentType_enum {
  EK
  FULL
  VK
  IGNORE
}

Enum priceType_enum {
  WEEKDAY
  WEEKNIGHT
  WEEKENDDAY
  WEEKENDNIGHT
}

Enum log_level_enum {
  INFO
  ERROR
  SECURITY
}

Enum log_type_enum {
  CONSULTATION
  CONSULTATION_TRANSMIT
  CONTACT
}

Enum invoiceComponent_employeeType_enum {
  A1
  HN2
  HONORAR
}

